{
  "name": "image-prompt-library",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "verify": "powershell -ExecutionPolicy Bypass -File ./scripts/verify.ps1",
    "after-import": "python scripts/after-import.py",
    "build:x-manifest": "python scripts/build-x-manifest.py",
    "check:library": "python scripts/check-library-health.py",
    "import:x": "python scripts/import-x-prompt.py",
    "import:x-batch": "python scripts/import-x-batch.py",
    "prepare:x": "python scripts/prepare-x-import.py",
    "sync:demo-counts": "python scripts/sync-demo-counts.py --write",
    "build": "npm run typecheck && vite build",
    "build:demo": "cross-env VITE_DEMO_MODE=true VITE_BASE_PATH=/ npm run typecheck && cross-env VITE_DEMO_MODE=true VITE_BASE_PATH=/ vite build",
    "build:demo:v0.1": "cross-env VITE_DEMO_MODE=true VITE_BASE_PATH=/v0.1/ npm run build",
    "build:demo:v0.2": "cross-env VITE_DEMO_MODE=true VITE_BASE_PATH=/v0.2/ npm run build",
    "preview": "vite preview --host 127.0.0.1 --port 5177"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.1",
    "vite": "8.0.10",
    "typescript": "6.0.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "lucide-react": "1.11.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-tabs": "1.1.13",
    "tailwindcss": "4.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "10.1.0"
  }
}
